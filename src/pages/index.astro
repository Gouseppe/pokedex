---
import Layout from "../layouts/Layout.astro";
import { PokemonInfiniteScroll } from "../components/PokemonInfiniteScroll";
import { SearchInput } from "../components/SearchInput";
---

<Layout title="Pokedex Web">
  <main>
    <div class="pb-4">
      <SearchInput client:load />
    </div>

    <PokemonInfiniteScroll client:only="react" />
  </main>
</Layout>

<style>
  main {
    margin: auto;
    padding: 1rem;
    width: 1200px;
    max-width: calc(100% - 2rem);
    color: white;
    font-size: 20px;
    line-height: 1.6;
  }
</style>
