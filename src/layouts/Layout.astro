---
import { ClientRouter } from "astro:transitions";
import ThemeToggle from "../components/ThemeToggler.astro";
import { Charging } from "../components/Charging";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Pokedex web, para buscar el pokemon que quieras. Realizada con Astro + Reactjs + Tailwind + Typescript"
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="bg-slate-50 dark:bg-[#13151a] pt-4">
    <div
      class="charging-container fixed top-0 left-0 w-full h-full z-50 items-center justify-center bg-white dark:bg-[#13151a] hidden"
    >
      <Charging />
    </div>
    <h1 class="mb-4 flex justify-center text-7xl font-bold">
      <a href="/" class="block leading-[6.6rem]"> Pokedex </a>
    </h1>
    <ThemeToggle />

    <slot />

    <script>
      document.addEventListener("astro:before-preparation", (ev) => {
        const chargingContainer = document.querySelector(".charging-container");
        if (chargingContainer) {
          chargingContainer.classList.remove("hidden");
          chargingContainer.classList.add("flex");
        }
        console.log(ev.loader);
        // This event is triggered before the page is prepared
        console.log("Preparando la página...");
      });
      document.addEventListener("astro:after-preparation", () => {
        // This event is triggered before the page is prepared
        console.log("Página preparada");
      });
      document.addEventListener("astro:after-swap", () => {
        const chargingContainer = document.querySelector(".charging-container");

        if (chargingContainer) {
          chargingContainer.classList.remove("flex");
          chargingContainer.classList.add("hidden");
        }
        // This event is triggered after the page transition
        console.log("Página cargada");
      });
    </script>

    <style is:global>
      @font-face {
        font-family: "Pokemon Hollow";
        src: url("./../assets/fonts/pokemon-hollow/pokemon-hollow.ttf");
        font-display: swap;
      }
      :root {
        --accent: 136, 58, 234;
        --accent-light: 224, 204, 250;
        --accent-dark: 49, 10, 101;
        --accent-gradient: linear-gradient(
          45deg,
          rgb(var(--accent)),
          rgb(var(--accent-light)) 30%,
          white 60%
        );
      }
      html {
        font-family: system-ui, sans-serif;
        background: #13151a;
        background-size: 224px;
      }

      body {
        min-height: 100vh;
      }
      h1 {
        color: transparent;
        background-clip: text;
        background-image: linear-gradient(
          to left,
          #ffd700,
          #7b68ee,
          #3498db,
          #2ecc71,
          #ffd700
        );
        text-align: center;
        font-family: "Pokemon Hollow";
        animation: color 3s linear infinite;
        background-size: 500%;
      }
      @keyframes color {
        from {
          background-position: 0% 50%;
        }
        to {
          background-position: 100% 50%;
        }
      }
    </style>
  </body>
</html>
